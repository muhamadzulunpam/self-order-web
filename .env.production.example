# Salin menjadi .env.production lalu isi, sebelum menjalankan npm run build.
# Semua nilai VITE_* tertanam di hasil build, jadi jangan isi rahasia apa pun di sini.
VITE_API_URL=https://api.contoh.com/api
VITE_REVERB_APP_KEY=isi-dengan-REVERB_APP_KEY-dari-server
VITE_REVERB_HOST=ws.contoh.com
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https