# Alamat API backend (berakhiran /api)
VITE_API_URL=http://localhost:8000/api

# Real-time (Laravel Reverb). Kosongkan VITE_REVERB_APP_KEY untuk mematikan real-time:
# aplikasi tetap berjalan dengan pemeriksaan berkala.
VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http